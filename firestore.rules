rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. PRODUTOS (Cadastro Central e Estoque SMGOI013)
    match /produtos/{produtoId} {
      allow read, write: if true;
    }

    // 2. VÍNCULOS EAN (EAN ↔ Código Interno)
    match /vinculosEAN/{vinculoEanId} {
      allow read, write: if true;
    }

    // 3. VENCIMENTOS (Lotes com Unicidade por filialId_codigoInterno_digito_dataVencimento)
    match /vencimentos/{vencimentoId} {
      allow read, write: if true;
    }

    // 4. PROMOTORES (Cadastro, status, setores e permissões)
    match /promotores/{promotorId} {
      allow read, write: if true;
    }

    // 5. VÍNCULOS DE PROMOTOR (Códigos de 6 dígitos e tokens de ativação)
    match /vinculosPromotor/{vinculoId} {
      allow read, write: if true;
    }

    // 6. AUDITORIA (Registro imutável de operações)
    match /auditoria/{auditoriaId} {
      allow read, create: if true;
      allow update, delete: if false; // Auditoria é append-only
    }

    // Suporte a coleções legadas e sincronização transitória
    match /metadados/{docId} {
      allow read, write: if true;
    }

    match /catalogo_chunks/{chunkId} {
      allow read, write: if true;
    }

    match /vinculos_chunks/{chunkId} {
      allow read, write: if true;
    }

    match /saeou060_chunks/{chunkId} {
      allow read, write: if true;
    }

    match /historico_importacoes/{histId} {
      allow read, write: if true;
    }

    match /divergencias/{divId} {
      allow read, write: if true;
    }

    match /vinculos_promotores/{vinculoId} {
      allow read, write: if true;
    }

    match /auditoria_promotores/{auditoriaId} {
      allow read, write: if true;
    }

    match /operacoes_promotores/{operationId} {
      allow read, write: if true;
    }
  }
}
